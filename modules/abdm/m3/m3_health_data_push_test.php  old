function jsonResponse(array $data, int $statusCode = 200): void
{
    http_response_code($statusCode);
    echo json_encode(
        $data,
        JSON_UNESCAPED_SLASHES |
        JSON_UNESCAPED_UNICODE |
        JSON_PRETTY_PRINT
    );
    exit;
}

function generateRequestId(): string
{
    return sprintf(
        '%04x%04x-%04x-%04x-%04x-%04x%04x%04x',
        random_int(0, 0xffff),
        random_int(0, 0xffff),
        random_int(0, 0xffff),
        random_int(0, 0x0fff) | 0x4000,
        random_int(0, 0x3fff) | 0x8000,
        random_int(0, 0xffff),
        random_int(0, 0xffff),
        random_int(0, 0xffff)
    );
}

function xorBytes(string $a, string $b): string
{
    if (strlen($a) !== strlen($b)) {
        throw new RuntimeException('XOR input lengths do not match.');
    }

    return $a ^ $b;
}

function x25519PublicKeyToPem(string $rawPublicKey): string
{
    if (strlen($rawPublicKey) !== 32) {
        throw new RuntimeException('X25519 public key must be exactly 32 bytes.');
    }

    $derPrefix = hex2bin('302a300506032b656e032100');

    if ($derPrefix === false) {
        throw new RuntimeException('Unable to build X25519 DER prefix.');
    }

    $der = $derPrefix . $rawPublicKey;

    return "-----BEGIN PUBLIC KEY-----\n" .
        chunk_split(base64_encode($der), 64, "\n") .
        "-----END PUBLIC KEY-----\n";
}

function isoUtcFromMysql(?string $value): ?string
{
    if (!$value) {
        return null;
    }

    try {
        $date = new DateTime(
            $value,
            new DateTimeZone('Asia/Kolkata')
        );

        $date->setTimezone(new DateTimeZone('UTC'));

        return $date->format('Y-m-d\TH:i:s.v\Z');
    } catch (Throwable $e) {
        return null;
    }
}

function getRequestRow(mysqli $conn): ?array
{
    $stmt = $conn->prepare("
        SELECT
            id,
            hospital_id,
            patient_id,
            consent_request_id,
            consent_id,
            care_context_reference,
            date_from,
            date_to,
            data_push_url,
            crypto_alg,
            curve,
            key_parameters,
            key_value,
            nonce,
            expiry,
            private_key,
            transaction_id,
            request_id,
            status
        FROM abdm_m3_health_information_requests
        WHERE id = ?
          AND hospital_id = ?
        LIMIT 1
    ");

    if (!$stmt) {
        throw new RuntimeException(
            'Unable to prepare health-information request lookup: ' .
            $conn->error
        );
    }

    $requestId = REQUEST_ID;
    $hospitalId = HOSPITAL_ID;

    $stmt->bind_param(
        'ii',
        $requestId,
        $hospitalId
    );

    if (!$stmt->execute()) {
        $error = $stmt->error;
        $stmt->close();

        throw new RuntimeException(
            'Unable to execute health-information request lookup: ' .
            $error
        );
    }

    $result = $stmt->get_result();
    $row = $result->fetch_assoc();

    $stmt->close();

    return $row ?: null;
}

function updateDataResponse(
    mysqli $conn,
    int $localRequestId,
    string $response
): void {
    $stmt = $conn->prepare("
        UPDATE abdm_m3_health_information_requests
        SET
            data_response = ?,
            updated_at = NOW()
        WHERE id = ?
        LIMIT 1
    ");

    if (!$stmt) {
        return;
    }

    $stmt->bind_param(
        'si',
        $response,
        $localRequestId
    );

    $stmt->execute();
    $stmt->close();
}

