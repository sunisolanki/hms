    |--------------------------------------------------------------------------
    | DATA PUSH PAYLOAD
    |--------------------------------------------------------------------------
    */

    $payload = [
        'pageNumber' => 0,
        'pageCount' => 1,
        'transactionId' => $transactionId,
        'entries' => [
            $entry
        ],
        'keyMaterial' => $keyMaterial
    ];

    $jsonPayload = json_encode(
        $payload,
        JSON_UNESCAPED_SLASHES |
        JSON_UNESCAPED_UNICODE
    );

    if ($jsonPayload === false) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to encode DataPush payload.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | DATA PUSH REQUEST ID / TIMESTAMP
    |--------------------------------------------------------------------------
    */

    $dataPushRequestId =
        generateRequestId();

    $dataPushTimestamp =
        gmdate('Y-m-d\TH:i:s.v\Z');

    /*
    |--------------------------------------------------------------------------
    | LOAD ACTUAL HIU ID
    |--------------------------------------------------------------------------
    */

    $stmt = $conn->prepare("
        SELECT hiu_id
        FROM abdm_m3_settings
        WHERE hospital_id = ?
          AND environment = 'Sandbox'
          AND status = 'Active'
        ORDER BY id DESC
        LIMIT 1
    ");

    if (!$stmt) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to load active M3 HIU settings.'
        ], 500);
    }

    $hospitalId = HOSPITAL_ID;

    $stmt->bind_param(
        'i',
        $hospitalId
    );

    if (!$stmt->execute()) {
        $error = $stmt->error;
        $stmt->close();
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to execute HIU settings lookup.',
            'error' => $error
        ], 500);
    }

    $settingsResult =
        $stmt->get_result();

    $settings =
        $settingsResult->fetch_assoc();

    $stmt->close();

    if (!$settings) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Active Sandbox M3 settings not found.'
        ], 404);
    }

    $hiuId = trim(
        (string)($settings['hiu_id'] ?? '')
    );

    if ($hiuId === '') {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'HIU ID is empty in M3 settings.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | DATA PUSH CURL
    |--------------------------------------------------------------------------
    */

    $ch = curl_init(
        DATA_PUSH_ENDPOINT
    );

    curl_setopt_array(
        $ch,
        [
            CURLOPT_POST => true,
            CURLOPT_POSTFIELDS => $jsonPayload,
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => [
                'Content-Type: application/json',
                'Accept: application/json',
                'REQUEST-ID: ' . $dataPushRequestId,
                'TIMESTAMP: ' . $dataPushTimestamp,
                'X-HIU-ID: ' . $hiuId
            ],
            CURLOPT_TIMEOUT => 60,
            CURLOPT_CONNECTTIMEOUT => 20,
            CURLOPT_SSL_VERIFYPEER => true,
            CURLOPT_SSL_VERIFYHOST => 2
        ]
    );

    $dataPushResponse =
        curl_exec($ch);

    $dataPushCurlError =
        curl_error($ch);

    $dataPushHttpStatus =
        (int)curl_getinfo(
            $ch,
            CURLINFO_HTTP_CODE
        );

    curl_close($ch);

    /*
    |--------------------------------------------------------------------------
    | STORE DATA PUSH RESPONSE
    |--------------------------------------------------------------------------
    */

    $storedDataResponse =
        $dataPushResponse !== false &&
        $dataPushResponse !== ''
            ? $dataPushResponse
            : $dataPushCurlError;

    updateDataResponse(
        $conn,
        $localRequestId,
        $storedDataResponse
    );

    $decodedDataPushResponse = null;

    if (is_string($dataPushResponse) &&
        $dataPushResponse !== '') {
        $decodedDataPushResponse =
            json_decode(
                $dataPushResponse,
                true
            );
    }

    /*
    |--------------------------------------------------------------------------
    | CLOSE DATABASE
    |--------------------------------------------------------------------------
    */

    $conn->close();

    /*
    |--------------------------------------------------------------------------
    | FINAL RESULT
    |--------------------------------------------------------------------------
    */

    $success =
        $dataPushHttpStatus >= 200 &&
        $dataPushHttpStatus < 300 &&
        $dataPushCurlError === '';

    jsonResponse([
        'success' => $success,
        'message' => $success
            ? 'DataPush endpoint accepted the health-information payload.'
            : 'DataPush endpoint returned non-success status.',
        'local_request_id' => $localRequestId,
        'transaction_id' => $transactionId,
        'care_context_reference' => $careContextReference,
        'hiu_id' => $hiuId,
        'fhir_resource_type' =>
            $fhirBundle['resourceType'] ?? null,
        'fhir_bundle_type' =>
            $fhirBundle['type'] ?? null,
        'fhir_entry_count' => $fhirEntryCount,
        'plain_text_bytes' => strlen($fhirJson),
        'hip_public_key_bytes' => strlen($hipPublicRaw),
        'hip_nonce_bytes' => strlen($hipNonce),
        'shared_secret_bytes' => strlen($sharedSecret),
        'salt_bytes' => strlen($salt),
        'iv_bytes' => strlen($iv),
        'aes_key_bytes' => strlen($aesKey),
        'aes_256_gcm_encryption' => 'SUCCESS',
        'ciphertext_bytes' => strlen($ciphertext),
        'gcm_tag_bytes' => strlen($gcmTag),
        'encrypted_content_bytes' =>
            strlen($encryptedContent),
        'content_base64_bytes' =>
            strlen(base64_encode($encryptedContent)),
        'checksum_algorithm' => 'MD5',
        'checksum' => $checksum,
        'page_number' => 0,
        'page_count' => 1,
        'media' => 'application/fhir+json',
        'local_decryption' => 'SUCCESS',
        'local_decryption_match' => $decryptionMatch,
        'checksum_verification' => $checksumVerification
            ? 'PASS'
            : 'FAIL',
        'key_material' => [
            'cryptoAlg' => 'ECDH',
            'curve' => 'Curve25519',
            'parameters' =>
                'Curve25519/32byte random key',
            'hip_public_key_bytes' =>
                strlen($hipPublicRaw),
            'hip_nonce_bytes' =>
                strlen($hipNonce)
        ],
        'data_push_http_status' =>
            $dataPushHttpStatus,
        'data_push_request_id' =>
            $dataPushRequestId,
        'data_push_curl_error' =>
            $dataPushCurlError,
        'data_push_response' =>
            $decodedDataPushResponse ??
            $dataPushResponse
    ], $success ? 200 : 502);

} catch (Throwable $e) {

    jsonResponse([
        'success' => false,
        'message' => 'M3 Health Data Push test failed.',
        'error' => $e->getMessage()
    ], 500);
}
