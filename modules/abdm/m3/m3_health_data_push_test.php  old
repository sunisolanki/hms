        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Stored HIU nonce is invalid.'
        ], 500);
    }

    if ($hiuPrivatePem === '') {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Stored HIU private key is missing.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | VERIFY HIU PRIVATE KEY
    |--------------------------------------------------------------------------
    */

    $hiuPrivateKey = openssl_pkey_get_private(
        $hiuPrivatePem
    );

    if ($hiuPrivateKey === false) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to import stored HIU private key.'
        ], 500);
    }

    $hiuDetails = openssl_pkey_get_details(
