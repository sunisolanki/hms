    );

    if ($hiuDetails === false ||
        !isset($hiuDetails['x25519']['pub_key'])) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Stored private key is not a valid X25519 key.'
        ], 500);
    }

    $recoveredHiuPublicRaw =
        $hiuDetails['x25519']['pub_key'];

    if (!hash_equals(
        $hiuPublicRaw,
        $recoveredHiuPublicRaw
    )) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Stored HIU public key does not match private key.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | LOAD FHIR BUNDLE
    |--------------------------------------------------------------------------
    */

    $fhirJson = file_get_contents(FHIR_FILE);

    if ($fhirJson === false || trim($fhirJson) === '') {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to read FHIR test bundle.'
        ], 500);
    }

    $fhirBundle = json_decode(
        $fhirJson,
        true
    );

    if (!is_array($fhirBundle)) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'FHIR bundle JSON is invalid.'
        ], 400);
    }

    if (($fhirBundle['resourceType'] ?? '') !== 'Bundle') {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'FHIR resourceType is not Bundle.'
        ], 400);
    }

    if (($fhirBundle['type'] ?? '') !== 'document') {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'FHIR Bundle type is not document.'
        ], 400);
    }

    $fhirEntryCount = isset($fhirBundle['entry']) &&
        is_array($fhirBundle['entry'])
        ? count($fhirBundle['entry'])
        : 0;

    /*
    |--------------------------------------------------------------------------
    | GENERATE HIP X25519 KEY PAIR
    |--------------------------------------------------------------------------
    */

    $hipPrivateKey = openssl_pkey_new([
        'x25519' => []
    ]);

    if ($hipPrivateKey === false) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to generate HIP X25519 key pair.'
        ], 500);
    }

    $hipDetails = openssl_pkey_get_details(
        $hipPrivateKey
    );

    if ($hipDetails === false ||
        !isset($hipDetails['x25519']['pub_key'])) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to read HIP X25519 public key.'
        ], 500);
    }

    $hipPublicRaw =
        $hipDetails['x25519']['pub_key'];

    if (!is_string($hipPublicRaw) ||
        strlen($hipPublicRaw) !== 32) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Generated HIP public key is invalid.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | HIP NONCE
    |--------------------------------------------------------------------------
    */

    $hipNonce = random_bytes(32);

    /*
    |--------------------------------------------------------------------------
    | CONVERT HIU PUBLIC KEY TO PEM
    |--------------------------------------------------------------------------
    */

    $hiuPublicPem = x25519PublicKeyToPem(
        $hiuPublicRaw
    );

    $hiuPublicKey = openssl_pkey_get_public(
        $hiuPublicPem
    );

    if ($hiuPublicKey === false) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to import HIU X25519 public key.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | ECDH
    |--------------------------------------------------------------------------
    */

    $sharedSecret = openssl_pkey_derive(
        $hiuPublicKey,
        $hipPrivateKey,
        32
    );

    if ($sharedSecret === false ||
        strlen($sharedSecret) !== 32) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'X25519 ECDH key derivation failed.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | NONCE COMBINATION
    |--------------------------------------------------------------------------
    */

    $combinedNonce = xorBytes(
        $hipNonce,
        $hiuNonce
    );

    if (strlen($combinedNonce) !== 32) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Combined nonce length is invalid.'
        ], 500);
    }

    $salt = substr(
        $combinedNonce,
        0,
        20
    );

    $iv = substr(
        $combinedNonce,
        20,
        12
    );

    /*
    |--------------------------------------------------------------------------
    | HKDF
    |--------------------------------------------------------------------------
    */

    $aesKey = hash_hkdf(
        'sha256',
        $sharedSecret,
        32,
        '',
        $salt
    );

    if (!is_string($aesKey) ||
        strlen($aesKey) !== 32) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Unable to derive AES-256 key.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | AES-256-GCM ENCRYPTION
    |--------------------------------------------------------------------------
    */

    $gcmTag = '';

    $ciphertext = openssl_encrypt(
        $fhirJson,
        'aes-256-gcm',
        $aesKey,
        OPENSSL_RAW_DATA,
        $iv,
        $gcmTag
    );

    if ($ciphertext === false) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'AES-256-GCM encryption failed.'
        ], 500);
    }

    if (!is_string($gcmTag) ||
        strlen($gcmTag) !== 16) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Invalid GCM authentication tag.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | CONTENT = CIPHERTEXT + GCM TAG
    |--------------------------------------------------------------------------
    */

    $encryptedContent =
        $ciphertext . $gcmTag;

    /*
    |--------------------------------------------------------------------------
    | CHECKSUM
    |--------------------------------------------------------------------------
    |
    | Current M2/M3 test implementation uses MD5 over the plaintext
    | FHIR payload. This is retained for consistency with our existing
    | sandbox test.
    |
    */

    $checksum = md5(
        $fhirJson
    );

    /*
    |--------------------------------------------------------------------------
    | LOCAL DECRYPTION TEST
    |--------------------------------------------------------------------------
    */

    $receivedCiphertext = substr(
        $encryptedContent,
        0,
        -16
    );

    $receivedTag = substr(
        $encryptedContent,
        -16
    );

    $decryptedText = openssl_decrypt(
        $receivedCiphertext,
        'aes-256-gcm',
        $aesKey,
        OPENSSL_RAW_DATA,
        $iv,
        $receivedTag
    );

    if ($decryptedText === false) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Local AES-256-GCM decryption failed.'
        ], 500);
    }

    $decryptionMatch =
        hash_equals(
            $fhirJson,
            $decryptedText
        );

    if (!$decryptionMatch) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Local encryption/decryption mismatch.'
        ], 500);
    }

    $checksumVerification =
        hash_equals(
            $checksum,
            md5($decryptedText)
        );

    if (!$checksumVerification) {
        $conn->close();

        jsonResponse([
            'success' => false,
            'message' => 'Local checksum verification failed.'
        ], 500);
    }

    /*
    |--------------------------------------------------------------------------
    | DATA PUSH EXPIRY
    |--------------------------------------------------------------------------
    */

    $expiry = isoUtcFromMysql(
        $request['expiry'] ?? null
    );

    if ($expiry === null) {
        $expiryDate = new DateTime(
            'now',
            new DateTimeZone('UTC')
        );

        $expiryDate->modify('+10 minutes');

        $expiry = $expiryDate->format(
            'Y-m-d\TH:i:s.v\Z'
        );
    }

    /*
    |--------------------------------------------------------------------------
    | DATA PUSH KEY MATERIAL
    |--------------------------------------------------------------------------
    |
    | The receiver needs the actual HIP ephemeral public key and nonce
    | used for this encryption operation.
    |
    */

    $keyMaterial = [
        'cryptoAlg' => 'ECDH',
        'curve' => 'Curve25519',
        'dhPublicKey' => [
            'expiry' => $expiry,
            'parameters' => 'Curve25519/32byte random key',
            'keyValue' => base64_encode(
                $hipPublicRaw
            )
        ],
        'nonce' => base64_encode(
            $hipNonce
        )
    ];

    /*
    |--------------------------------------------------------------------------
    | DATA PUSH ENTRY
    |--------------------------------------------------------------------------
    */

    $entry = [
        'content' => base64_encode(
            $encryptedContent
        ),
        'media' => 'application/fhir+json',
        'checksum' => $checksum,
        'careContextReference' => $careContextReference
    ];

